# Keep generated/source files stable across Windows/macOS/Linux.
* text=auto
*.js text eol=lf
public/dashboard-chunks/*.js whitespace=-blank-at-eol
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
