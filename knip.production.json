{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/knip-production-runtime.mjs!",
        "bin/**/*.js!",
        "src/connectionProfile.js!",
        "src/config.js!",
        "src/desktopUxContracts.js!",
        "src/process.js!",
        "src/localAnalytics.js!",
        "src/telemetry.js!",
        "src/httpServer.ts!",
        "src/toolActivity.js!",
        "src/http/dashboardSessions.ts!",
        "src/processManager.js!",
        "public/dashboard.js!"
      ],
      "project": [
        "scripts/knip-production-runtime.mjs!",
        "bin/**/*.js!",
        "src/**/*.{js,ts,tsx,css}!",
        "public/dashboard.js!"
      ],
      "ignore": [
        "public/dashboard-react.js",
        "public/dashboard-chunks/**"
      ],
      "paths": {
        "./ui/*": [
          "src/ui/*"
        ]
      },
      "ignoreDependencies": [
        "monaco-editor",
        "pyright",
        "typescript-language-server",
        "typescript-lsp-runtime"
      ]
    },
    "electron": {
      "entry": [
        "main.js!",
        "preload.cjs!",
        "service-process.js!",
        "renderer/status.js!",
        "renderer/wizard.js!",
        "renderer/pulse.js!",
        "build/after-pack.js!",
        "scripts/verify-fuses.js!"
      ],
      "project": [
        "*.{js,cjs,ts,tsx}!",
        "renderer/**/*.{js,ts,tsx}!",
        "build/**/*.js!"
      ],
      "ignoreDependencies": [
        "electron-builder",
        "node-pty"
      ]
    }
  }
}
