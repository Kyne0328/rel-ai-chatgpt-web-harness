{
  "name": "rel-ai-mcp",
  "productName": "Rel.AI MCP",
  "version": "1.1.1",
  "description": "Local agency/runtime harness that turns ChatGPT Web into a repository- and computer-capable development agent.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "src/contracts",
    "src/core",
    "src/repository/intelligence",
    "src/ui"
  ],
  "files": [
    "skills/",
    "bin/",
    "src/",
    "public/",
    "examples/",
    "types/",
    "vendor/tree-sitter/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "TERMS.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "release-manifest.json"
  ],
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.8.2 <27",
    "npm": ">=12.0.0 <13"
  },
  "bin": {
    "rel-ai-mcp": "bin/rel-ai-mcp.js",
    "relai-mcp-config": "bin/relai-mcp-config.js",
    "rel-ai-mcp-http": "bin/rel-ai-mcp-http.js"
  },
  "scripts": {
    "start": "node bin/rel-ai-mcp.js",
    "test:security": "node test/security-process-boundaries-unit.mjs && node test/hard-boundary-unit.mjs && node test/project-instructions-unit.mjs && node test/mcp-task-scope-unit.mjs && node test/dashboard-navigation-security-unit.mjs && node test/legal-surfaces-unit.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:electron": "node scripts/clean.mjs --electron",
    "clean:release": "node scripts/clean.mjs --release",
    "start:http": "npm run build:frontend && node bin/rel-ai-mcp-http.js",
    "check:quick": "node test/check-js.mjs",
    "check": "npm run check:quick && node test/dependency-maintenance-unit.mjs && node test/esm-hard-cutover-unit.mjs && npm run verify:node-pty && npm run verify:generated && npm run verify:tree-sitter-assets && npm run lint && npm run typecheck && npm run knip:dependencies && npm run audit:test-rigidity",
    "lint": "eslint src electron test scripts bin --max-warnings=0 && node scripts/check-module-boundaries.mjs",
    "knip": "knip",
    "knip:dependencies": "knip --dependencies --treat-config-hints-as-errors",
    "knip:production": "knip --production --dependencies --config knip.production.json",
    "generate:color-tokens": "node scripts/generate-color-tokens.mjs",
    "verify:generated": "node scripts/check-generated.mjs",
    "verify:node-pty": "node scripts/verify-node-pty-runtime.mjs",
    "verify:color-tokens": "node scripts/generate-color-tokens.mjs --check",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:packaging": "node scripts/audit-packaging.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "test:plugin": "node test/plugin-package-unit.mjs",
    "test:skills": "node test/skill-package-behavior-unit.mjs && node test/plugin-metadata-unit.mjs && node test/extensions-unit.mjs",
    "test:tool-routing": "node test/host-local-routing-contract-unit.mjs && node test/tool-behavior-evaluator-unit.mjs",
    "audit:test-rigidity": "node scripts/audit-test-rigidity.mjs",
    "measure:tool-surface": "node scripts/measure-tool-surface.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.boundaries.json && tsc -b tsconfig.packages.json",
    "init-config": "node bin/relai-mcp-config.js init",
    "workspace:add": "node bin/relai-mcp-config.js workspace add",
    "test": "npm run test:all",
    "test:repo-health": "node test/repo-health.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:http": "node test/http-smoke.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "release:check": "npm run verify:generated && node scripts/release-check.mjs",
    "release:finalize": "node scripts/release-finalize.mjs",
    "release": "node scripts/release-bump.mjs",
    "test:release": "npm run test:all && npm run test:web-automation && node test/release-workflow-smoke.mjs && npm run knip:production && npm run audit:production && npm run audit:packaging",
    "test:context": "node test/context/static-context-unit.mjs && node test/context/context-builder-unit.mjs && node test/context/session-compaction-unit.mjs && node test/context/tool-discovery-budget-unit.mjs && node test/workspace-context-smoke.mjs",
    "test:hard-cutover": "node test/chatgpt-local-hard-cutover-smoke.mjs",
    "test:public-workflow": "node test/workflow-smoke.mjs",
    "test:connector-wording": "node test/connector-wording-smoke.mjs",
    "test:regressions": "node test/regression-fixes-smoke.mjs",
    "test:repository-intelligence": "node test/run-repository-intelligence-tests.mjs && node scripts/verify-tree-sitter-assets.mjs",
    "test:unit": "node test/run-tests.mjs && node test/session-summary-unit.mjs",
    "test:integration": "npm run test:native-tasks-release-gate && node test/run-repository-intelligence-tests.mjs",
    "electron:dev": "npm run build:frontend && cd electron && npx electron .",
    "electron:dev:watch": "node scripts/electron-dev-watch.mjs",
    "electron:dev:watch:isolated": "node scripts/electron-dev-watch.mjs --isolated",
    "electron:runtime": "node electron/node_modules/electron/install.js",
    "electron:build:id": "node scripts/print-local-build-id.mjs",
    "electron:build": "node scripts/electron-package.mjs --mode unpacked --platform win32",
    "electron:build:windows": "node scripts/electron-package.mjs --mode unpacked --platform win32",
    "electron:build:linux": "node scripts/electron-package.mjs --mode unpacked --platform linux",
    "electron:build:mac": "node scripts/electron-package.mjs --mode unpacked --platform darwin",
    "electron:dist": "node scripts/electron-package.mjs --mode release --platform win32",
    "electron:dist:windows": "node scripts/electron-package.mjs --mode release --platform win32",
    "electron:dist:linux": "node scripts/electron-package.mjs --mode release --platform linux",
    "electron:dist:mac": "node scripts/electron-package.mjs --mode release --platform darwin",
    "electron:size": "node scripts/electron-package-size.mjs --dir dist --platform win32 --baseline scripts/electron-size-baseline.json",
    "electron:size:windows": "node scripts/electron-package-size.mjs --dir dist --platform win32 --baseline scripts/electron-size-baseline.json",
    "electron:size:linux": "node scripts/electron-package-size.mjs --dir dist --platform linux --baseline scripts/electron-size-baseline-linux.json",
    "fetch:tunnel-client": "node scripts/fetch-tunnel-client.mjs",
    "verify:tunnel-client": "node scripts/verify-tunnel-client.mjs",
    "test:electron": "node test/electron-tool-activity-runtime-unit.mjs && node test/desktop-notifications-unit.mjs && node test/desktop-tray-unit.mjs && node test/pulse-window-unit.mjs && node test/dashboard-window-unit.mjs && node test/browser-surface-host-unit.mjs && node test/electron-browser-surface-browser.mjs && node test/service-runtime-lifecycle-unit.mjs && node test/service-process-client-unit.mjs && node test/shutdown-coordinator-unit.mjs && node test/secure-tunnel-runtime-unit.mjs && node test/tunnel-recovery-supervisor-unit.mjs && node test/tunnel-credentials-unit.mjs && node test/secure-tunnel-packaging-contract-unit.mjs && node test/electron-dev-watch-unit.mjs",
    "test:wizard-browser": "node test/electron-wizard-browser.mjs",
    "test:filter-browser": "node test/filter-experience-browser.mjs",
    "test:frontend-browser": "npm run test:wizard-browser && npm run test:filter-browser && npm run test:custom-chrome-browser && npm run test:observability-browser && node test/code-editor-browser.mjs",
    "test:frontend": "npm run test:frontend-browser",
    "test:observability-browser": "node test/dashboard-browser-acceptance.mjs",
    "benchmark:observability": "node --expose-gc scripts/observability-benchmark.mjs",
    "benchmark:observability:strict": "node --expose-gc scripts/observability-benchmark.mjs --enforce-thresholds",
    "benchmark:internal-parallelism": "node scripts/benchmark-internal-parallelism.mjs",
    "benchmark:repository-index": "node scripts/repository-intelligence-benchmark.mjs --files 100000 --json",
    "benchmark:tool-orchestration": "node scripts/benchmark-exec-phases.mjs",
    "benchmark:computer": "node scripts/computer-control-benchmark.mjs",
    "benchmark:computer:strict": "node scripts/computer-control-benchmark.mjs --enforce-thresholds",
    "benchmark:mcp-startup": "node test/mcp-startup-budget-unit.mjs",
    "verify:packaged": "node scripts/verify-packaged-wrapper.mjs",
    "verify:updater-artifacts": "node scripts/verify-updater-artifacts.mjs",
    "prepare:release-assets": "node scripts/prepare-release-assets.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "test:connector-acceptance": "node scripts/packaged-connector-acceptance.mjs",
    "test:native-tasks-release-gate": "node scripts/native-tasks-release-gate.mjs",
    "test:http-auth": "node test/http-auth-smoke.mjs",
    "test:safety-paths": "node test/safety-paths.mjs",
    "test:dashboard-wording": "node test/dashboard-wording-smoke.mjs",
    "test:workflow-config": "node test/workflow-config-normalization.mjs",
    "test:patch-update": "node test/patch-update-smoke.mjs",
    "test:checks": "node test/command-checks-smoke.mjs",
    "test:git-workflow": "node test/git-workflow-smoke.mjs",
    "test:staged-write": "node test/staged-write-fallback-unit.mjs",
    "test:colors": "npm run verify:color-tokens && node test/color-system-unit.mjs",
    "test:all": "npm run check && npm run knip:production && npm run test:security && npm run test:electron && npm run test:integration && npm run test:unit && npm run test:plugin && npm run test:skills && npm run test:tool-routing && npm run test:regressions && npm run test:colors && npm run test:public-workflow",
    "build:frontend": "node scripts/generate-color-tokens.mjs && node scripts/generate-ui-contracts.mjs && vite build && node scripts/write-dashboard-generated-manifest.mjs",
    "dev:frontend": "node scripts/generate-color-tokens.mjs && node scripts/generate-ui-contracts.mjs && vite",
    "watch:frontend": "node scripts/generate-color-tokens.mjs && node scripts/generate-ui-contracts.mjs && vite build --watch",
    "test:custom-chrome-browser": "node test/electron-custom-chrome-browser.mjs",
    "test:web-automation": "node test/browser-runtime-unit.mjs && node test/browser-native-driver-unit.mjs && node test/browser-local-io-unit.mjs && node test/browser-runtime-local-fixture.mjs && node test/web-automation-contract-unit.mjs && node test/web-automation-relai-browser.mjs",
    "fetch:zoekt": "pwsh scripts/fetch-zoekt.ps1",
    "verify:zoekt": "node scripts/verify-zoekt-seed.mjs",
    "verify:tree-sitter-assets": "node scripts/verify-tree-sitter-assets.mjs",
    "benchmark:repository-resolvers": "node scripts/repository-resolver-precision-benchmark.mjs --json"
  },
