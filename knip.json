{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/*.js",
        "scripts/*.mjs",
        "test/*.mjs",
        "public/dashboard.js"
      ],
      "project": [
        "bin/**/*.js",
        "scripts/**/*.mjs",
        "src/**/*.{js,mjs,ts,tsx,css}",
        "test/**/*.mjs",
        "types/**/*.d.ts"
      ],
      "paths": {
        "./ui/*": [
          "src/ui/*"
        ]
      },
      "ignoreBinaries": [
        "dpkg-query",
        "pwsh"
      ],
      "ignoreDependencies": [
        "monaco-editor",
        "pyright",
        "typescript-language-server",
        "tailwindcss"
      ]
    },
    "electron": {
      "entry": [
        "preload.cjs",
        "service-process.js",
        "build/after-pack.js",
        "scripts/*.js",
        "renderer/*.js"
      ],
      "project": [
        "**/*.{js,cjs,ts,tsx}"
      ],
      "ignoreDependencies": [
        "electron-builder",
        "node-pty"
      ]
    }
  },
  "tags": [
    "-knipdynamic"
  ]
}
