{
  "name": "rel-ai-mcp-launcher",
  "desktopName": "com.relai.mcp.desktop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Desktop runtime and dashboard for the Rel.AI ChatGPT Web harness.",
  "homepage": "https://github.com/Kyne0328/rel-ai-chatgpt-web-harness",
  "author": {
    "name": "Kyne",
    "email": "Kyne0328@users.noreply.github.com",
    "url": "https://github.com/Kyne0328"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "exports": {},
  "engines": {
    "node": ">=26.8.2 <27",
    "npm": ">=12.0.0 <13"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.relai.mcp",
    "productName": "Rel.AI MCP",
    "electronUpdaterCompatibility": ">=2.16",
    "afterPack": "build/after-pack.js",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kyne0328",
        "repo": "rel-ai-chatgpt-web-harness",
        "releaseType": "prerelease"
      }
    ],
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "desktop-host.js",
      "desktop-os-operations.js",
      "pulse-window.js",
      "pulse-state.js",
      "browser-surface-host.js",
      "preload.cjs",
      "launcher-utils.js",
      "secure-tunnel-runtime.js",
      "tunnel-log-parser.js",
      "tunnel-recovery-supervisor.js",
      "tunnel-credentials.js",
      "ipc-handlers.js",
      "ipc-handlers-dashboard.js",
      "ipc-handlers-code.js",
      "task-code-ide.js",
      "launcher-config.js",
      "resource-path.js",
      "window-size.js",
      "desktop-power.js",
      "tool-sleep-blocker.js",
      "taskbar-completion-badge.js",
      "dashboard-window.js",
      "dashboard-window-navigation.js",
      "dashboard-window-bounds.js",
      "window-chrome.js",
      "startup-background.js",
      "desktop-tray.js",
      "desktop-status.js",
      "build-provenance.js",
      "recovery-window.js",
      "window-security.js",
      "local-protocol.js",
      "runtime-log-buffer.js",
      "runtime-log-snapshot.js",
      "diagnostic-files.js",
      "app-updater.js",
      "app-updater-events.js",
      "app-updater-state.js",
      "app-updater-status.js",
      "macos-manual-updater.js",
      "update-version.js",
      "update-support-policy.js",
      "ipc-security.js",
      "desktop-settings.js",
      "desktop-local-data.js",
      "desktop-notifications.js",
      "desktop-lifecycle.js",
      "shutdown-coordinator.js",
      "controller-runtime.js",
      "service-runtime.js",
      "service-process.js",
      "service-process-client.js",
      "service-activity-projection.js",
      "setup-window.js",
      "renderer/**",
      "build/icon.png",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.js",
          "**/*.ts",
          "**/*.ps1"
        ]
      },
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../vendor/tree-sitter",
        "to": "vendor/tree-sitter",
        "filter": [
          "manifest.json",
          "**/*.wasm"
        ]
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "@modelcontextprotocol/core/**",
          "@modelcontextprotocol/node/**",
          "@modelcontextprotocol/server/**",
          "@midscene/**",
          "@computer-use/**",
          "@img/**",
          "@jimp/**",
          "@silvia-odwyer/**",
          "@tokenizer/**",
          "@ui-tars/**",
          "abort-controller/**",
          "any-base/**",
          "argparse/**",
          "base64-js/**",
          "bindings/**",
          "bmp-js/**",
          "brace-expansion/**",
          "buffer/**",
          "buffer-equal/**",
          "centra/**",
          "character-entities/**",
          "clipboardy/**",
          "cross-spawn/**",
          "dayjs/**",
          "debug/**",
          "decode-named-character-reference/**",
          "dequal/**",
          "detect-libc/**",
          "devlop/**",
          "dom-walk/**",
          "dotenv/**",
          "event-target-shim/**",
          "events/**",
          "execa/**",
          "exif-parser/**",
          "fetch-socks/**",
          "file-type/**",
          "file-uri-to-path/**",
          "follow-redirects/**",
          "fs.realpath/**",
          "get-stream/**",
          "gifwrap/**",
          "glob/**",
          "global/**",
          "human-signals/**",
          "ieee754/**",
          "image-q/**",
          "ip-address/**",
          "is-docker/**",
          "is-function/**",
          "is-inside-container/**",
          "is-stream/**",
          "is-wsl/**",
          "is64bit/**",
          "isexe/**",
          "isomorphic-fetch/**",
          "jimp/**",
          "jpeg-js/**",
          "js-sha256/**",
          "js-yaml/**",
          "jsonrepair/**",
          "load-bmfont/**",
          "lodash.isnumber/**",
          "longest-streak/**",
          "lru-cache/**",
          "mdast-util-*/**",
          "merge-stream/**",
          "micromark*/**",
          "mime/**",
          "mimic-fn/**",
          "min-document/**",
          "minimatch/**",
          "minimist/**",
          "minipass/**",
          "mkdirp/**",
          "ms/**",
          "node-abort-controller/**",
          "node-fetch/**",
          "node-mac-permissions/**",
          "npm-run-path/**",
          "omggif/**",
          "onetime/**",
          "p-queue/**",
          "p-timeout/**",
          "eventemitter3/**",
          "openai/**",
          "pako/**",
          "parse-bmfont-*/**",
          "parse-headers/**",
          "path-key/**",
          "path-scurry/**",
          "peek-readable/**",
          "phin/**",
          "pixelmatch/**",
          "pngjs/**",
          "process/**",
          "readable-stream/**",
          "readable-web-to-node-stream/**",
          "regenerator-runtime/**",
          "rimraf/**",
          "safe-buffer/**",
          "sax/**",
          "screenshot-desktop/**",
          "semver/**",
          "yallist/**",
          "sharp/**",
          "shebang-command/**",
          "shebang-regex/**",
          "signal-exit/**",
          "smart-buffer/**",
          "socks/**",
          "string_decoder/**",
          "strip-final-newline/**",
          "strtok3/**",
          "system-architecture/**",
          "temp/**",
          "timm/**",
          "tinycolor2/**",
          "token-types/**",
          "tr46/**",
          "undici/**",
          "unist-util-*/**",
          "utif2/**",
          "uuid/**",
          "webidl-conversions/**",
          "whatwg-fetch/**",
          "whatwg-url/**",
          "which/**",
          "xhr/**",
          "xml-parse-from-string/**",
          "xml2js/**",
          "xmlbuilder/**",
          "xtend/**",
          "zwitch/**",
          "balanced-match/**",
          "concat-map/**",
          "inflight/**",
          "inherits/**",
          "once/**",
          "wrappy/**",
          "path-is-absolute/**",
          "@opentelemetry/**",
          "@hono/node-server/**",
          "hono/**",
          "zod/**",
          "playwright-core/**",
          "web-tree-sitter/**",
          "typescript-language-server/**",
          "pyright/**",
          "monaco-editor/min/vs/**",
          "@kwsites/file-exists/**",
          "@kwsites/promise-deferred/**",
          "@sec-ant/readable-stream/**",
          "@simple-git/args-pathspec/**",
          "@simple-git/argv-parser/**",
          "@sindresorhus/merge-streams/**",
          "ajv/**",
          "fast-deep-equal/**",
          "fast-uri/**",
          "json-schema-traverse/**",
          "require-from-string/**",
          "piscina/**",
          "vscode-jsonrpc/**",
          "commander/**",
          "is-plain-obj/**",
          "is-unicode-supported/**",
          "parse-ms/**",
          "which-command/**",
          "write-file-atomic/**",
          "yoctocolors/**",
          "figures/**",
          "unicorn-magic/**",
          "pretty-ms/**",
          "simple-git/**",
          "!**/*.map",
          "!@modelcontextprotocol/*/src/**",
          "!@opentelemetry/*/src/**",
          "!@hono/*/src/**",
          "!hono/src/**",
          "!zod/src/**",
          "!**/test/**",
          "!**/tests/**",
          "!@computer-use/nut-js/**",
          "!@computer-use/shared/**",
          "!@jimp/**",
          "!file-type/**",
          "!jimp/**",
          "!**/*.ts",
          "!**/*.cts",
          "!**/*.mts"
        ]
      },
      {
        "from": "../node_modules/typescript-lsp-runtime",
        "to": "node_modules/typescript-lsp-runtime",
        "filter": [
          "package.json",
          "lib/**",
          "!lib/typescript.d.ts",
          "!lib/tsserverlibrary.d.ts"
        ]
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../release-manifest.json",
        "to": "release-manifest.json"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "../TERMS.md",
        "to": "TERMS.md"
      },
      {
        "from": "../SECURITY.md",
        "to": "SECURITY.md"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../vendor/tunnel-client",
          "to": "bin/tunnel-client",
          "filter": [
            "manifest.json",
            "win32/**"
          ]
        },
        {
          "from": "../vendor/zoekt",
          "to": "bin/zoekt",
          "filter": [
            "manifest.json",
            "LICENSE",
            "win32/**"
          ]
        },
        {
          "from": "node_modules/node-pty",
          "to": "node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**",
            "prebuilds/win32-${arch}/**"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Local ChatGPT Web development harness",
      "description": "Rel.AI is a local agency/runtime harness for ChatGPT Web, providing approved repositories, tasks, commands, validation, Git, observability, memory/skills, and opt-in computer control through a secured desktop-managed MCP connection.",
      "vendor": "Kyne",
      "maintainer": "Kyne <Kyne0328@users.noreply.github.com>",
      "executableName": "rel-ai-mcp",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Rel.AI MCP",
          "Comment": "Use ChatGPT Web with a local development harness for approved projects",
          "Categories": "Development;Utility;",
          "Keywords": "ChatGPT;harness;MCP;coding-agent;development;repository;agent;",
          "StartupWMClass": "com.relai.mcp",
          "Terminal": false,
          "Type": "Application"
        }
      },
      "extraResources": [
        {
          "from": "../vendor/tunnel-client",
          "to": "bin/tunnel-client",
          "filter": [
            "manifest.json",
            "linux/**"
          ]
        },
        {
          "from": "../vendor/zoekt",
          "to": "bin/zoekt",
          "filter": [
            "manifest.json",
            "LICENSE",
            "linux/**"
          ]
        },
        {
          "from": "node_modules/node-pty",
          "to": "node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**",
            "build/Release/pty.node",
            "build/Release/spawn-helper"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extraResources": [
        {
          "from": "../vendor/tunnel-client",
          "to": "bin/tunnel-client",
          "filter": [
            "manifest.json",
            "darwin/**"
          ]
        },
        {
          "from": "../vendor/zoekt",
          "to": "bin/zoekt",
          "filter": [
            "manifest.json",
            "LICENSE",
            "darwin/**"
          ]
        },
        {
          "from": "node_modules/node-pty",
          "to": "node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**",
            "prebuilds/darwin-${arch}/**"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Rel.AI-MCP-${version}-mac-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Rel.AI-MCP-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Rel.AI-MCP-${version}-linux-x64.${ext}",
      "packageName": "rel-ai-mcp-launcher",
      "packageCategory": "devel",
      "priority": "optional"
    },
    "nsis": {
      "artifactName": "Rel.AI-MCP-Setup-${version}.${ext}",
      "installerIcon": "build/installer-icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rel.AI MCP",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Rel.AI-MCP-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "p-retry": "^8.0.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
